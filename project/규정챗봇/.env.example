# 규정챗봇 환경변수 예시
# 실제 값은 .env에만 저장하고 Git에 커밋하지 않는다.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_ENCRYPTION_KEY=

# LLM 실행 모드: provider_api
LLM_MODE=provider_api

# LLM 공급자: gemini, openai, claude
LLM_PROVIDER=gemini

# 운영 권장 방식은 관리자 화면에서 암호화 Secret으로 저장하는 것이다.
# 아래 값은 초기 로컬 개발 부트스트랩이 필요한 경우에만 사용한다.
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# DB
DATABASE_URL=sqlite:///db.sqlite3

# 선택: 패키징/배포 환경에서 런타임 데이터와 로컬 모델 위치를 분리할 때 사용
# 비워 두면 프로젝트 내부 backend/, backend/models/ 기준으로 동작한다.
REGBOT_DATA_DIR=
REGBOT_MODELS_DIR=

# 사내 메신저 연동은 추후 확정
MESSENGER_CLIENT_ID=
MESSENGER_CLIENT_SECRET=
MESSENGER_WEBHOOK_SECRET=
